  "spec": "SPEC.md#5.2",
  "vectors": [
    {
      "id": "deleg-denied-outside-grant",
      "description": "A capability may delegate only to capabilities it declares.",
      "registry": {
        "a": {
          "can_delegate_to": [
            "b"
          ]
        },
        "b": {},
        "c": {}
      },
      "request": {
        "requesting_capability": "a",
        "required_capability": "c",
        "depth": 1,
        "ancestry": [
          "a"
        ]
      },
      "budget": {},
      "expect_error": "DelegationDenied",
      "expect_spawns_used": 0
    },
    {
