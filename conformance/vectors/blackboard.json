        }
      ]
    },
    {
      "id": "bb-superseding-post-hidden-from-reader-leaves-older-value",
      "description": "If a newer post is not readable by a requester, the newest post it CAN read is returned.",
      "task_id": "t1",
      "tenant_id": "acme",
      "steps": [
        {
          "op": "post",
          "capability": "a",
          "key": "k",
          "value": 1
        },
        {
          "op": "post",
          "capability": "a",
          "key": "k",
          "value": 2,
          "visible_to": []
        },
        {
          "op": "read",
          "requester": "b",
          "capability": "a",
          "key": "k",
          "expect": 1
        },
        {
          "op": "read",
          "requester": "a",
          "capability": "a",
          "key": "k",
          "expect": 2
        }
      ]
    }
  ]
}
