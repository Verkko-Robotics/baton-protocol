{
  "suite": "flow",
  "operation": "flow",
  "spec": "SPEC.md#5",
  "vectors": [
    {
      "id": "flow-side-effect-suspends-before-executing",
      "description": "A side-effecting tool call pauses for approval and does not run.",
      "registry": {
        "sender": {
          "tools": [
            "send_email"
          ]
        }
      },
      "tool_specs": [
        {
          "name": "send_email",
          "side_effect": true
        }
      ],
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "sender",
          "depends_on": []
        }
      ],
      "llm": [
        {
          "tool_calls": [
            [
              "send_email",
              {
                "to": "a@b.c"
              }
            ]
          ]
        }
      ],
      "expect_first": {
        "suspended": true
      },
      "expect": {
        "suspended": true,
        "invocations": [],
        "subtask_status": {
          "s1": "blocked"
        }
      }
    },
    {
      "id": "flow-read-only-tool-runs-without-approval",
      "description": "A tool not marked side-effecting runs without approval.",
      "registry": {
        "researcher": {
          "tools": [
            "web_search"
          ]
        }
      },
      "tool_specs": [
        {
          "name": "web_search",
          "side_effect": false
        }
      ],
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "researcher",
          "depends_on": []
        }
      ],
      "llm": [
        {
          "tool_calls": [
            [
              "web_search",
              {
                "q": "x"
              }
            ]
          ]
        },
        {
          "text": "done"
        }
      ],
      "expect": {
        "suspended": false,
        "invocations": [
          "web_search"
        ],
        "subtask_status": {
          "s1": "completed"
        }
      }
    },
