    {
      "id": "flow-failed-prerequisite-skips-dependents",
      "description": "A failed prerequisite stops its branch and records a gap, instead of running on missing input.",
      "registry": {
        "a": {
          "tools": []
        },
        "b": {
          "tools": []
        }
      },
      "tool_specs": [],
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "a",
          "depends_on": []
        },
        {
          "id": "s2",
          "required_capability": "b",
          "depends_on": [
            "s1"
          ]
        }
      ],
      "llm": [
        {
          "error": "model unavailable"
        }
      ],
      "expect": {
        "suspended": false,
        "invocations": [],
        "subtask_status": {
          "s1": "failed",
          "s2": "skipped"
        },
        "gap_kinds": [
          "external_dependency"
        ]
      }
    },
    {
      "id": "flow-output-is-published-with-declared-readers",
      "description": "A result is posted as <capability>.output, readable only by the capabilities its producer named.",
      "registry": {
        "producer": {
          "tools": [],
          "output_visible_to": [
            "consumer"
          ]
        }
      },
      "tool_specs": [],
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "producer",
          "depends_on": []
        }
      ],
      "llm": [
        {
          "text": "fact-1"
        }
      ],
      "expect": {
        "suspended": false,
        "invocations": [],
        "subtask_status": {
          "s1": "completed"
        },
        "blackboard": [
          {
            "requester": "consumer",
            "capability": "producer",
            "key": "output",
            "value": "fact-1"
          },
          {
            "requester": "outsider",
            "capability": "producer",
            "key": "output",
            "value": null
          },
          {
            "requester": "producer",
            "capability": "producer",
            "key": "output",
            "value": "fact-1"
          }
        ]
      }
    },
