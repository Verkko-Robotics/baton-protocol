    {
      "id": "flow-approval-then-resume-executes",
      "description": "After approval the parked call executes and the run completes; state survives serialization.",
      "registry": {
        "sender": {
          "tools": [
            "send_email"
          ]
        }
      },
      "tool_specs": [
        {
          "name": "send_email",
          "side_effect": true
        }
      ],
      "tool_results": {
        "send_email": "message-1"
      },
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "sender",
          "depends_on": []
        }
      ],
      "llm": [
        {
          "tool_calls": [
            [
              "send_email",
              {
                "to": "a@b.c"
              }
            ]
          ]
        },
        {
          "text": "sent"
        }
      ],
      "after_run": {
        "serialize": true,
        "resume": {
          "subtask_id": "s1",
          "approved": true
        }
      },
      "expect_first": {
        "suspended": true
      },
      "expect": {
        "suspended": false,
        "invocations": [
          "send_email"
        ],
        "subtask_status": {
          "s1": "completed"
        }
      }
    },
    {
      "id": "flow-denial-is-not-a-failure",
      "description": "A denied action is fed back to the specialist; it can finish without it.",
      "registry": {
        "sender": {
          "tools": [
            "send_email"
          ]
        }
      },
      "tool_specs": [
        {
          "name": "send_email",
          "side_effect": true
        }
      ],
      "subtasks": [
        {
          "id": "s1",
          "required_capability": "sender",
          "depends_on": []
        }
      ],
      "llm": [
        {
          "tool_calls": [
            [
              "send_email",
              {
                "to": "a@b.c"
              }
            ]
          ]
        },
        {
          "text": "finished without sending"
        }
      ],
      "after_run": {
        "serialize": true,
        "resume": {
