{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verkko-Robotics/baton-protocol/schemas/1.0/pending-approval.schema.json",
  "title": "PendingApproval",
  "description": "A side-effecting tool call frozen awaiting human authorization. Additional properties MUST be accepted and preserved (forward compatibility).",
  "type": "object",
  "properties": {
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object"
    },
    "call_id": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tool_name"
  ]
}
