{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verkko-Robotics/baton-protocol/schemas/1.0/budget.schema.json",
  "title": "TaskBudget",
  "description": "Task-wide resource ceilings and usage, shared by every specialist in a task tree. Additional properties MUST be accepted and preserved (forward compatibility).",
  "type": "object",
  "properties": {
    "max_total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_spawns": {
      "type": "integer",
      "minimum": 0
    },
    "max_spawn_depth": {
      "type": "integer",
      "minimum": 0
    },
    "max_tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0
    },
    "spawns_used": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls_used": {
      "type": "integer",
      "minimum": 0
    }
  }
}
